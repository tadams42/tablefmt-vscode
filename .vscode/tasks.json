{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "esbuild watch",
      "type": "shell",
      "command": "node esbuild.mjs --watch",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": ".",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "watching...",
          "endsPattern": "watching..."
        }
      },
      "group": "build"
    }
  ]
}
