{
  "name": "tablefmt-vscode",
  "displayName": "tablefmt",
  "description": "Format selections as tables — no external binary required",
  "version": "0.1.1",
  "publisher": "tadams42",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/tadams42/tablefmt-vscode"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Formatters"
  ],
  "activationEvents": [],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tablefmt.dataToTable",
        "title": "Data to table",
        "category": "tablefmt"
      },
      {
        "command": "tablefmt.dataToTableStyle",
        "title": "Data to table with style",
        "category": "tablefmt"
      },
      {
        "command": "tablefmt.formatTable",
        "title": "Format table",
        "category": "tablefmt"
      },
      {
        "command": "tablefmt.formatTableToStyle",
        "title": "Format table to style",
        "category": "tablefmt"
      },
      {
        "command": "tablefmt.addColumnBefore",
        "title": "Add column before cursor",
        "category": "tablefmt"
      },
      {
        "command": "tablefmt.addColumnAfter",
        "title": "Add column after cursor",
        "category": "tablefmt"
      },
      {
        "command": "tablefmt.removeColumn",
        "title": "Remove column at cursor",
        "category": "tablefmt"
      }
    ],
    "configuration": {
      "title": "tablefmt",
      "properties": {
        "tablefmt.defaultStyle": {
          "type": "string",
          "default": "github",
          "enum": [
            "github",
            "psql",
            "asciidoc",
            "jira",
            "rst",
            "rst-grid",
            "orgtbl",
            "ascii",
            "modern",
            "sharp",
            "extended",
            "heavy-outline"
          ],
          "enumDescriptions": [
            "GitHub Flavored Markdown pipes",
            "PostgreSQL psql client borders",
            "AsciiDoc",
            "Jira",
            "reStructuredText simple tables",
            "reStructuredText grid tables",
            "Emacs org-mode",
            "Plain ASCII",
            "Unicode box-drawing (modern)",
            "Unicode sharp corners",
            "Extended box-drawing",
            "Heavy outline box-drawing"
          ],
          "markdownDescription": "Default output table style used by the `Data to table` command."
        }
      }
    },
    "menus": {
      "editor/context": [
        {
          "command": "tablefmt.dataToTable",
          "when": "!editorReadonly",
          "group": "1_modification@50"
        },
        {
          "command": "tablefmt.dataToTableStyle",
          "when": "!editorReadonly",
          "group": "1_modification@50"
        },
        {
          "command": "tablefmt.formatTable",
          "when": "!editorReadonly",
          "group": "1_modification@51"
        },
        {
          "command": "tablefmt.formatTableToStyle",
          "when": "!editorReadonly",
          "group": "1_modification@51"
        },
        {
          "command": "tablefmt.addColumnBefore",
          "when": "!editorReadonly",
          "group": "1_modification@52"
        },
        {
          "command": "tablefmt.addColumnAfter",
          "when": "!editorReadonly",
          "group": "1_modification@53"
        },
        {
          "command": "tablefmt.removeColumn",
          "when": "!editorReadonly",
          "group": "1_modification@54"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc --noEmit",
    "bundle": "node esbuild.mjs",
    "bundle:watch": "node esbuild.mjs --watch",
    "vscode:prepublish": "node esbuild.mjs --minify",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.0",
    "esbuild": "^0.28.1",
    "typescript": "^5.8.0",
    "vitest": "^4.1.8"
  }
}
